<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="v1.0.0-003" author="finflow-foundation">
        <comment>Create users_aud shadow audit table for ACID mutation tracing</comment>

        <createTable tableName="users_aud">
            <column name="audit_id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_users_aud" nullable="false"/>
            </column>
            <column name="id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="rev_type" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="diff_data" type="CLOB"/>
            <column name="modified_by" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="ip_address" type="VARCHAR(45)"/>
            <column name="rev_timestamp" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="users_aud" indexName="idx_users_aud_entity_id">
            <column name="id"/>
        </createIndex>

        <createIndex tableName="users_aud" indexName="idx_users_aud_timestamp">
            <column name="rev_timestamp" descending="true"/>
        </createIndex>

        <createIndex tableName="users_aud" indexName="idx_users_aud_actor">
            <column name="modified_by"/>
        </createIndex>

        <rollback>
            <dropIndex tableName="users_aud" indexName="idx_users_aud_actor"/>
            <dropIndex tableName="users_aud" indexName="idx_users_aud_timestamp"/>
            <dropIndex tableName="users_aud" indexName="idx_users_aud_entity_id"/>
            <dropTable tableName="users_aud"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
